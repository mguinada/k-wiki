.DS_Store
# The file below is versioned by design. It is generated fixture
# data for the sync-layer noise case, not a real macOS artifact. The
# snapshot test compares it byte-for-byte against generator output.
# See tests/fixtures/README.md before you change this.
!tests/fixtures/Documents/.DS_Store

# Data (raw/, wiki/) contents live in the data repo (sync.json dataRoot).
# Only the tracked skeleton files below those paths are versioned here;
# tracked files stay tracked, and any new file under these trees is
# invisible to git add — by design (issue #29).
raw/**
wiki/**

# skill-creator eval workspace (scratch)
.agents/skills/do-gh-issue-workspace/
.codegraph/
node_modules
coverage/

# StrykerJS: mutation temp dir, HTML report, and incremental state
.stryker-tmp/
reports/

# E2E scratch: temp vaults, sync.json, and raw dirs (tests/e2e/helpers.ts);
# gitignored also excludes it from Biome via vcs.useIgnoreFile.
.e2e-tmp/

# Mutation-run debris: a StringLiteral mutant on the --dry-run flag
# filter makes the CLI treat the flag as the raw-dir positional and
# really sync into a ./--dry-run/ directory before the tests kill it.
# Same class: mutants on the -h/--help checks in the fixture and sync
# CLIs write a vault into ./--help/ or ./-h/.
--dry-run/
--help/
-h/

# In-process CLI import staging (transient; see tests/sync-cli-spawn.test.ts)
tests/.cli-import-staging/

# In-process health-CLI import staging (transient; see tests/health-check.test.ts)
tests/.health-import-staging/

# In-process data-init CLI import staging (transient; see tests/data-init.test.ts)
tests/.data-init-import-staging/
