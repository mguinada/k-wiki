{
  "name": "k-wiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An LLM-maintained knowledge wiki, derived from a human-owned Obsidian vault.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "health": "node bin/check-raw.ts",
    "board-triage": "node bin/board-triage.ts",
    "dashboard": "node bin/dashboard.ts",
    "check-links": "node bin/check-links.ts",
    "check-crosslinks": "node bin/check-crosslinks.ts",
    "check-provenance": "node bin/check-provenance.ts",
    "check-fidelity": "node bin/check-fidelity.ts",
    "backfill-origin": "node bin/backfill-origin.ts",
    "link-sources": "node bin/link-sources.ts",
    "anchor-citations": "node bin/anchor-citations.ts",
    "open-origin": "node bin/open-origin.ts",
    "fixtures": "node bin/generate.ts",
    "sync-vault": "node bin/sync-vault.ts",
    "sync-repo": "node bin/sync-repo.ts",
    "wiki-ingest": "node bin/wiki-ingest.ts",
    "wiki-sync": "node bin/wiki-sync.ts",
    "scheduled-run": "node bin/scheduled-run.ts",
    "setup-schedule": "node bin/setup-schedule.ts",
    "wiki-query": "node bin/wiki-query.ts",
    "k-wiki": "node bin/k-wiki.ts",
    "data:init": "node bin/init-data-repo.ts",
    "mutation": "stryker run",
    "mutation:changed": "sh src/quality/mutation-changed.sh",
    "mutation:survivors": "node bin/mutation-survivors.ts",
    "mutation:chunk": "node bin/mutation-chunk.ts",
    "mutation:merge": "node bin/mutation-merge.ts",
    "mutation:report": "node bin/mutation-report.ts",
    "complexity": "vitest run --disableConsoleIntercept tests/quality/complexity.test.ts",
    "complexity:full": "COMPLEXITY_FULL=1 vitest run --disableConsoleIntercept tests/quality/complexity.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "complexity-guard": "0.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
