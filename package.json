{
  "name": "k-wiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An LLM-maintained knowledge wiki, derived from a human-owned Obsidian vault.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "health": "node src/health/check-raw.ts",
    "check-links": "node scripts/check-links.ts",
    "fixtures": "node src/fixtures/generate.ts",
    "sync-vault": "node src/sync/sync-vault.ts",
    "wiki-ingest": "node src/ingest/wiki-ingest.ts",
    "data:init": "node src/data/init-data-repo.ts",
    "mutation": "stryker run",
    "mutation:changed": "sh scripts/mutation-changed.sh",
    "mutation:survivors": "node scripts/mutation-survivors.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
